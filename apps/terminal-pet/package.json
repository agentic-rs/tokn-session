{
  "name": "@tokn/terminal-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts -- --demo",
    "demo": "bun src/main.ts --demo",
    "snapshot": "bun src/main.ts --snapshot running --no-color",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3"
  }
}
